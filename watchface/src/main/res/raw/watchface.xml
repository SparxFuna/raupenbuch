        </PartImage>
        <PartText x="4" y="39" width="74" height="26">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="SYNC_TO_DEVICE" size="20" weight="MEDIUM" color="#ffeef6ef">
              <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
            </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="MONOCHROMATIC_IMAGE">
        <PartDraw x="0" y="0" width="82" height="82">
          <Variant mode="AMBIENT" target="alpha" value="0"/>
          <Ellipse x="0" y="0" width="82" height="82"><Fill color="#e62f5a43"/></Ellipse>
        </PartDraw>
        <PartDraw x="0" y="0" width="82" height="82">
          <Ellipse x="1" y="1" width="80" height="80"><Stroke thickness="2" color="#ff1f3d2d"/></Ellipse>
          <Variant mode="AMBIENT" target="alpha" value="120"/>
        </PartDraw>
        <PartImage x="20" y="20" width="41" height="41" tintColor="#ffeef6ef">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
        </PartImage>
      </Complication>
      <Complication type="SMALL_IMAGE">
        <PartImage x="0" y="0" width="82" height="82">
          <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
        </PartImage>
      </Complication>
    </ComplicationSlot>
    <ComplicationSlot x="340" y="162" width="82" height="82" slotId="2" displayName="slot_right" supportedTypes="SHORT_TEXT RANGED_VALUE MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY">
      <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT" defaultSystemProviderType="SHORT_TEXT"/>
      <BoundingOval x="0" y="0" width="82" height="82"/>
      <Complication type="SHORT_TEXT">
        <PartDraw x="0" y="0" width="82" height="82">
          <Variant mode="AMBIENT" target="alpha" value="0"/>
          <Ellipse x="0" y="0" width="82" height="82"><Fill color="#e62f5a43"/></Ellipse>
