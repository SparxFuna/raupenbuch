<?xml version="1.0" encoding="utf-8"?>
<!-- Raupi-Zifferblatt (Watch Face Format 1). Bilder werden aus der Raupenbuch-App gerendert. -->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
  <Metadata key="PREVIEW_TIME" value="10:08:32"/>
  <Scene backgroundColor="#ff000000">
    <PartImage x="0" y="0" width="450" height="450" name="bg">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Image resource="raupi_bg"/>
    </PartImage>

    <DigitalClock x="0" y="0" width="450" height="450">
      <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="70" width="450" height="112" alpha="255">
        <Variant mode="AMBIENT" target="alpha" value="0"/>
        <Font family="SYNC_TO_DEVICE" size="104" weight="BOLD" color="#ff1f3d2d"/>
      </TimeText>
      <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="70" width="450" height="112" alpha="0">
        <Variant mode="AMBIENT" target="alpha" value="255"/>
        <Font family="SYNC_TO_DEVICE" size="104" weight="THIN" color="#ffffffff"/>
      </TimeText>
    </DigitalClock>

    <PartText x="0" y="182" width="450" height="40" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="28" color="#ff2f5a43">
          <Template>%s, %s. %s<Parameter expression="[DAY_OF_WEEK_S]"/><Parameter expression="[DAY]"/><Parameter expression="[MONTH_S]"/></Template>
        </Font>
      </Text>
    </PartText>
    <PartText x="0" y="182" width="450" height="40" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255"/>
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="28" color="#ffaaaaaa">
          <Template>%s, %s. %s<Parameter expression="[DAY_OF_WEEK_S]"/><Parameter expression="[DAY]"/><Parameter expression="[MONTH_S]"/></Template>
        </Font>
      </Text>
    </PartText>

    <!-- Raupis Tag: wandern, tanzen, Ball spielen (Endlosschleife) -->
    <PartAnimatedImage x="45" y="238" width="360" height="149" name="raupi">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <AnimationController play="ON_VISIBLE" repeat="TRUE" resumePlayBack="TRUE" beforePlaying="FIRST_FRAME" afterPlaying="FIRST_FRAME"/>
      <AnimatedImage resource="raupi_day" format="WEBP" thumbnail="raupi_thumb"/>
    </PartAnimatedImage>

    <!-- Antippen: Herzchen -->
    <PartAnimatedImage x="45" y="238" width="360" height="149" name="hearts">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <AnimationController play="TAP" beforePlaying="HIDE" afterPlaying="HIDE"/>
      <AnimatedImage resource="raupi_hearts" format="WEBP" thumbnail="raupi_hearts_thumb"/>
    </PartAnimatedImage>

    <!-- Ambient: ruhende Raupi, gedimmt -->
    <PartImage x="45" y="238" width="360" height="149" name="raupi_ambient" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255"/>
      <Image resource="raupi_ambient"/>
    </PartImage>

    <!-- Komplikationen: auf der Uhr per langem Drücken → Anpassen auswählbar -->
    <ComplicationSlot x="192" y="10" width="66" height="66" slotId="0" displayName="slot_top" supportedTypes="SHORT_TEXT RANGED_VALUE MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY">
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY"/>
      <BoundingOval x="0" y="0" width="66" height="66"/>
      <Complication type="SHORT_TEXT">
        <PartDraw x="0" y="0" width="66" height="66">
          <Variant mode="AMBIENT" target="alpha" value="0"/>
          <Ellipse x="0" y="0" width="66" height="66"><Fill color="#e62f5a43"/></Ellipse>
        </PartDraw>
        <PartDraw x="0" y="0" width="66" height="66">
          <Ellipse x="1" y="1" width="64" height="64"><Stroke thickness="2" color="#ff1f3d2d"/></Ellipse>
          <Variant mode="AMBIENT" target="alpha" value="120"/>
        </PartDraw>
        <PartImage x="23" y="11" width="20" height="20" tintColor="#ffeef6ef">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
        </PartImage>
        <PartText x="4" y="32" width="58" height="21">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="SYNC_TO_DEVICE" size="16" weight="MEDIUM" color="#ffeef6ef">
              <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
            </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="RANGED_VALUE">
        <PartDraw x="0" y="0" width="66" height="66">
          <Variant mode="AMBIENT" target="alpha" value="0"/>
          <Ellipse x="0" y="0" width="66" height="66"><Fill color="#e62f5a43"/></Ellipse>
        </PartDraw>
        <PartDraw x="0" y="0" width="66" height="66">
          <Ellipse x="1" y="1" width="64" height="64"><Stroke thickness="2" color="#ff1f3d2d"/></Ellipse>
          <Variant mode="AMBIENT" target="alpha" value="120"/>
        </PartDraw>
        <PartDraw x="4" y="4" width="58" height="58">
          <Arc centerX="29.0" centerY="29.0" width="52" height="52" startAngle="-140" endAngle="140">
            <Stroke thickness="4" color="#40ffffff" cap="ROUND"/>
          </Arc>
          <Arc centerX="29.0" centerY="29.0" width="52" height="52" startAngle="-140" endAngle="140">
            <Stroke thickness="4" color="#fff2b632" cap="ROUND"/>
            <Transform target="endAngle" value="-140 + (clamp([COMPLICATION.RANGED_VALUE_VALUE], [COMPLICATION.RANGED_VALUE_MIN], [COMPLICATION.RANGED_VALUE_MAX]) - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]) * 280"/>
          </Arc>
        </PartDraw>
        <PartImage x="23" y="11" width="20" height="20" tintColor="#ffeef6ef">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
        </PartImage>
        <PartText x="4" y="32" width="58" height="21">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="SYNC_TO_DEVICE" size="16" weight="MEDIUM" color="#ffeef6ef">
              <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
            </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="MONOCHROMATIC_IMAGE">
        <PartDraw x="0" y="0" width="66" height="66">
          <Variant mode="AMBIENT" target="alpha" value="0"/>
          <Ellipse x="0" y="0" width="66" height="66"><Fill color="#e62f5a43"/></Ellipse>
        </PartDraw>
        <PartDraw x="0" y="0" width="66" height="66">
          <Ellipse x="1" y="1" width="64" height="64"><Stroke thickness="2" color="#ff1f3d2d"/></Ellipse>
          <Variant mode="AMBIENT" target="alpha" value="120"/>
        </PartDraw>
        <PartImage x="16" y="16" width="33" height="33" tintColor="#ffeef6ef">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
        </PartImage>
      </Complication>
      <Complication type="SMALL_IMAGE">
        <PartImage x="0" y="0" width="66" height="66">
          <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
        </PartImage>
      </Complication>
    </ComplicationSlot>
    <ComplicationSlot x="28" y="162" width="82" height="82" slotId="1" displayName="slot_left" supportedTypes="SHORT_TEXT RANGED_VALUE MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY">
      <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY" defaultSystemProviderType="RANGED_VALUE"/>
      <BoundingOval x="0" y="0" width="82" height="82"/>
